CHAT_COUNT_TABLE_NAME=dev-user_chat_count
CHAT_HISTORY_TABLE_NAME=dev-user_chat_history
TRIAL_CHAT_LIMIT=5
CHAT_HISTORY_LIMIT=10

# DynamoDB Local 使用時（本番環境では DYNAMODB_ENDPOINT_URL を設定しない）
DYNAMODB_ENDPOINT_URL=http://localhost:8000
# boto3 が自動認識する AWS 認証情報（CI/本番では環境変数 or IAMロールで注入）
AWS_DEFAULT_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
